{% extends 'layouts/status.twig' %}
{% block title %}{{ 'Confirm subscription'|t }}{% endblock %}
{% block content %}
<section class="st-section st-subscribe">
    <h1>{{ 'Confirm subscription'|t }}</h1>
    {% if done %}
        <div class="alert alert-success">{{ 'Your subscription is active. You will receive an e-mail about new incidents and maintenance.'|t }}</div>
    {% elseif valid %}
        <p>{{ 'Please confirm that you want to receive e-mails about incidents and maintenance.'|t }}</p>
        <form method="post" action="/status/subscribe/confirm">
            {{ csrf_field() }}
            <input type="hidden" name="token" value="{{ token }}">
            <button class="btn btn-primary" type="submit">{{ 'Confirm subscription'|t }}</button>
        </form>
    {% else %}
        <div class="alert alert-warning">{{ 'This link is invalid or has expired. Please subscribe again.'|t }}</div>
    {% endif %}
    <p><a href="/status">&larr; {{ 'Back to the status page'|t }}</a></p>
</section>
{% endblock %}
