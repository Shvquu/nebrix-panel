{# "Still need help?" box: support ticket. #}
{% import 'macros/icons.twig' as i %}
<div class="help-more site-card">
    <div>
        <h2>{{ 'Still need help?'|t }}</h2>
        <p class="site-muted">{{ 'Our support team is happy to help you personally.'|t }}</p>
    </div>
    <div class="site-actions">
        {% if setting('system.tickets_enabled') %}<a class="site-btn site-btn-primary" href="/tickets/create">{{ i.icon('support') }} {{ 'Open a support ticket'|t }}</a>{% endif %}
    </div>
</div>
