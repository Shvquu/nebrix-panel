{% extends 'layouts/customer.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ product.name }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ product.name }}</h1><p class="muted"><a href="/store">&larr; {{ 'All products'|t }}</a></p></div></div>
{# Coupon: its own GET form (no CSRF token in the URL); the applied code travels with the order form. #}
{% set cfg = quote.configuration %}
{% if ranges and cfg %}
{# Configurator: a GET form, so that the price on this page is always calculated by the server. #}
<form method="get" action="/store/{{ product.slug }}" class="card p-configurator" novalidate>
    <div class="card-header"><h2>{{ (ranges.slots is defined ? 'Configure your TeamSpeak server' : (ranges.cpu_cores is defined ? 'Configure your game server' : 'Configure your server'))|t }}</h2></div>
    <div class="card-body">
        {% if coupon %}<input type="hidden" name="coupon" value="{{ coupon }}">{% endif %}
        {% set labels = {'cores': 'CPU cores', 'memory_gb': 'Memory (GB)', 'disk_gb': 'Disk size (GB)', 'slots': 'Slots', 'cpu_cores': 'CPU cores', 'backups': 'Backups', 'databases': 'Databases', 'ports': 'Additional ports'} %}
        {% set units = {'cores': ' vCores', 'memory_gb': ' GB', 'disk_gb': ' GB', 'slots': '', 'cpu_cores': '', 'backups': '', 'databases': '', 'ports': ''} %}
        {% for name, range in ranges %}
            {% if range.max > range.min %}
            <div class="form-row cfg-row">
                <label for="cfg-{{ name }}">{{ labels[name]|t }}: <strong id="cfg-{{ name }}-value">{{ cfg[name] }}{{ units[name] }}</strong></label>
                <input id="cfg-{{ name }}" type="range" name="{{ name }}" min="{{ range.min }}" max="{{ range.max }}" step="{{ range.step }}" value="{{ cfg[name] }}" data-output="#cfg-{{ name }}-value" data-unit="{{ units[name] }}" data-autosubmit>
                <div class="help">{{ range.min }}{{ units[name] }} {{ 'included'|t }} · {{ 'each additional step'|t }} +{{ range.price|money(product.currency) }} {{ 'net'|t }}</div>
            </div>
            {% else %}
                <input type="hidden" name="{{ name }}" value="{{ cfg[name] }}">
                <p class="small muted">{{ labels[name]|t }}: {{ cfg[name] }}{{ units[name] }}</p>
            {% endif %}
        {% endfor %}
        <noscript><button class="btn btn-outline" type="submit">{{ 'Update price'|t }}</button></noscript>
    </div>
</form>
{% endif %}
<form method="get" action="/store/{{ product.slug }}" class="card p-coupon" novalidate>
    <div class="card-body filters">
        {% if cfg %}{% for name, value in cfg %}{% if name != 'price' %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}{% endfor %}{% endif %}
        <div class="form-row">
            <label for="f-coupon-code">{{ 'Coupon code'|t }}</label>
            <input id="f-coupon-code" type="text" name="coupon" value="{{ coupon }}" maxlength="40" autocomplete="off" class="{{ quote.coupon_error ? 'is-invalid' : '' }}">
            {% if quote.coupon_error %}<div class="field-error">{{ quote.coupon_error|t }}</div>{% endif %}
        </div>
        <button class="btn btn-outline" type="submit">{{ 'Apply'|t }}</button>
        {% if quote.coupon_code %}<span class="badge badge-success badge-sentence">{{ 'Coupon :code applied'|t({code: quote.coupon_code}) }}{% if quote.coupon_duration == 'forever' %} · {{ 'also on renewals'|t }}{% endif %}</span> <a class="small" href="/store/{{ product.slug }}{% if cfg %}?{{ cfg|filter((v, k) => k != 'price')|url_encode }}{% endif %}">{{ 'Remove'|t }}</a>{% endif %}
    </div>
</form>
<form method="post" action="/store/{{ product.slug }}" novalidate>
    {{ csrf_field() }}
    {% if quote.coupon_code %}<input type="hidden" name="coupon" value="{{ quote.coupon_code }}">{% endif %}
    {% if cfg %}{% for name, value in cfg %}{% if name != 'price' %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}{% endfor %}{% endif %}
    <div class="grid grid-2">
        <div class="card">
            <div class="card-header"><h2>{{ 'Configuration'|t }}</h2></div>
            <div class="card-body">
                {% if product.description %}<p>{{ product.description }}</p>{% endif %}
                {% if cfg and cfg.cores is defined %}<p><span class="badge badge-info badge-sentence">{{ ':cores vCores, :memory GB RAM, :disk GB disk'|t({cores: cfg.cores, memory: cfg.memory_gb, disk: cfg.disk_gb}) }}</span></p>{% elseif cfg and cfg.slots is defined %}<p><span class="badge badge-info badge-sentence">{{ ':slots slots'|t({slots: cfg.slots}) }}</span></p>{% elseif cfg and cfg.cpu_cores is defined %}<p><span class="badge badge-info badge-sentence">{{ ':n GB memory'|t({n: cfg.memory_gb}) }}, {{ ':n cores'|t({n: cfg.cpu_cores}) }}, {{ ':n GB storage'|t({n: cfg.disk_gb}) }}</span></p>{% endif %}
                {% for name, option in options %}
                    {% if option.type|default('') in ['os_template', 'ssh_keys'] %}
                        {% include 'customer/store/_server_choices.twig' with {name: name, option: option, choices: server_order|default({templates: [], keys: {}})} only %}
                    {% else %}
                    {{ f.input(name, option.label, prefill[name]|default(''), 'text', option.help is defined ? {required: true, help: option.help} : {required: true}) }}
                    {% endif %}
                {% else %}
                    <p class="muted">{{ 'No configuration needed.'|t }}</p>
                {% endfor %}
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h2>{{ 'Summary'|t }}</h2></div>
            <div class="card-body">
                <dl class="details">
                    <dt>{{ 'Price'|t }}</dt><dd>{{ quote.price|money(product.currency) }} {{ cycles[product.billing_cycle]|default('')|t }}</dd>
                    {% if quote.setup_fee > 0 %}<dt>{{ 'Setup fee'|t }}</dt><dd>{{ quote.setup_fee|money(product.currency) }}</dd>{% endif %}
                    {% if quote.first_extra > 0 %}<dt>{{ 'First year surcharge'|t }}</dt><dd>{{ quote.first_extra|money(product.currency) }}</dd>{% endif %}
                    {% if quote.promo_discount > 0 %}<dt>{{ quote.sale_name ? quote.sale_name ~ ' ' : '' }}{{ 'Promotion −:percent %'|t({percent: quote.promo_bp / 100}) }}</dt><dd>−{{ quote.promo_discount|money(product.currency) }} <span class="small muted">{{ 'also on renewals'|t }}</span></dd>{% endif %}
                    {% if quote.first_promo > 0 %}<dt>{{ quote.sale_name ? quote.sale_name ~ ' ' : '' }}{{ 'Promotion −:percent %'|t({percent: quote.first_bp / 100}) }}</dt><dd>−{{ quote.first_promo|money(product.currency) }} <span class="small muted">{{ 'first billing period only'|t }}</span></dd>{% endif %}
                    {% if quote.group_discount > 0 %}<dt>{{ 'Discount'|t }}</dt><dd>−{{ quote.group_discount|money(product.currency) }}</dd>{% endif %}
                    {% if quote.first_discount > 0 %}<dt>{{ 'First year discount'|t }}</dt><dd>−{{ quote.first_discount|money(product.currency) }}</dd>{% endif %}
                    {% if quote.coupon_discount > 0 %}<dt>{{ 'Coupon :code'|t({code: quote.coupon_code}) }}</dt><dd>−{{ quote.coupon_discount|money(product.currency) }} <span class="small muted">{{ 'net'|t }}</span></dd>{% endif %}
                    <dt>{{ 'Tax'|t }} ({{ quote.tax_rate_bp|percent }})</dt><dd>{{ quote.tax|money(product.currency) }}</dd>
                    <dt><strong>{{ 'Due today'|t }}</strong></dt><dd><strong>{{ quote.total|money(product.currency) }}</strong></dd>
                    {% if product.billing_cycle != 'one_time' %}<dt>{{ 'Renews at'|t }}</dt><dd>{{ quote.recurring|money(product.currency) }} {{ cycles[product.billing_cycle]|t }}</dd>{% endif %}
                    {% if transfer_quote and transfer_quote.total != quote.total %}<dt>{{ 'Due today for a transfer'|t }}</dt><dd>{{ transfer_quote.total|money(product.currency) }} <span class="small muted">{{ 'with auth code'|t }}</span></dd>{% endif %}
                </dl>
                <div class="form-row mt-2">
                    <label class="checkbox"><input type="checkbox" name="accept_terms" value="1"> <span>{{ 'I accept the'|t }} {% if brand.terms_url %}<a href="{{ brand.terms_url }}" target="_blank" rel="noopener">{{ 'terms and conditions'|t }}</a>{% else %}{{ 'terms and conditions'|t }}{% endif %}.</span></label>
                    {% if error('accept_terms') %}<div class="field-error">{{ error('accept_terms')|t }}</div>{% endif %}
                </div>
                {% include 'marketing/_review_consent.twig' %}
            </div>
            <div class="card-footer"><button class="btn btn-primary btn-block" type="submit">{{ 'Order with obligation to pay'|t }}</button></div>
        </div>
    </div>
</form>
{% endblock %}
