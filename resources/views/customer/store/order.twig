{% extends 'layouts/customer.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ product.name }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ product.name }}</h1><p class="muted"><a href="/store">&larr; {{ 'All products'|t }}</a></p></div></div>
{# Coupon: its own GET form (no CSRF token in the URL); the applied code travels with the order form. #}
<form method="get" action="/store/{{ product.slug }}" class="card p-coupon" novalidate>
    <div class="card-body filters">
        <div class="form-row">
            <label for="f-coupon-code">{{ 'Coupon code'|t }}</label>
            <input id="f-coupon-code" type="text" name="coupon" value="{{ coupon }}" maxlength="40" autocomplete="off" class="{{ quote.coupon_error ? 'is-invalid' : '' }}">
            {% if quote.coupon_error %}<div class="field-error">{{ quote.coupon_error|t }}</div>{% endif %}
        </div>
        <button class="btn btn-outline" type="submit">{{ 'Apply'|t }}</button>
        {% if quote.coupon_code %}<span class="badge badge-success">{{ 'Coupon :code applied'|t({code: quote.coupon_code}) }}{% if quote.coupon_duration == 'forever' %} · {{ 'also on renewals'|t }}{% endif %}</span> <a class="small" href="/store/{{ product.slug }}">{{ 'Remove'|t }}</a>{% endif %}
    </div>
</form>
<form method="post" action="/store/{{ product.slug }}" novalidate>
    {{ csrf_field() }}
    {% if quote.coupon_code %}<input type="hidden" name="coupon" value="{{ quote.coupon_code }}">{% endif %}
    <div class="grid grid-2">
        <div class="card">
            <div class="card-header"><h2>{{ 'Configuration'|t }}</h2></div>
            <div class="card-body">
                {% if product.description %}<p>{{ product.description }}</p>{% endif %}
                {% for name, option in options %}
                    {{ f.input(name, option.label, '', 'text', option.help is defined ? {required: true, help: option.help} : {required: true}) }}
                {% else %}
                    <p class="muted">{{ 'No configuration needed.'|t }}</p>
                {% endfor %}
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h2>{{ 'Summary'|t }}</h2></div>
            <div class="card-body">
                <dl class="details">
                    <dt>{{ 'Price'|t }}</dt><dd>{{ quote.price|money(product.currency) }} {{ cycles[product.billing_cycle]|default('')|t }}</dd>
                    {% if quote.setup_fee > 0 %}<dt>{{ 'Setup fee'|t }}</dt><dd>{{ quote.setup_fee|money(product.currency) }}</dd>{% endif %}
                    {% if quote.discount - quote.coupon_discount > 0 %}<dt>{{ 'Discount'|t }}</dt><dd>−{{ (quote.discount - quote.coupon_discount)|money(product.currency) }}</dd>{% endif %}
                    {% if quote.coupon_discount > 0 %}<dt>{{ 'Coupon :code'|t({code: quote.coupon_code}) }}</dt><dd>−{{ quote.coupon_discount|money(product.currency) }} <span class="small muted">{{ 'net'|t }}</span></dd>{% endif %}
                    <dt>{{ 'Tax'|t }} ({{ quote.tax_rate_bp|percent }})</dt><dd>{{ quote.tax|money(product.currency) }}</dd>
                    <dt><strong>{{ 'Due today'|t }}</strong></dt><dd><strong>{{ quote.total|money(product.currency) }}</strong></dd>
                    {% if product.billing_cycle != 'one_time' %}<dt>{{ 'Renews at'|t }}</dt><dd>{{ quote.recurring|money(product.currency) }} {{ cycles[product.billing_cycle]|t }}</dd>{% endif %}
                </dl>
                <div class="form-row mt-2">
                    <label class="checkbox"><input type="checkbox" name="accept_terms" value="1"> <span>{{ 'I accept the'|t }} {% if brand.terms_url %}<a href="{{ brand.terms_url }}" target="_blank" rel="noopener">{{ 'terms and conditions'|t }}</a>{% else %}{{ 'terms and conditions'|t }}{% endif %}.</span></label>
                    {% if error('accept_terms') %}<div class="field-error">{{ error('accept_terms')|t }}</div>{% endif %}
                </div>
            </div>
            <div class="card-footer"><button class="btn btn-primary btn-block" type="submit">{{ 'Order with obligation to pay'|t }}</button></div>
        </div>
    </div>
</form>
{% endblock %}
