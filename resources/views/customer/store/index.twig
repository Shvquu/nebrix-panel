{% extends 'layouts/customer.twig' %}
{% import 'macros/icons.twig' as i %}
{% block title %}{{ 'Order new service'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Order new service'|t }}</h1><p class="muted">{{ 'Prices include the VAT that applies to you.'|t }}</p></div></div>
{% if sale %}<div class="alert alert-success"><strong>{{ sale.name }}</strong> · {{ (sale.permanent ? ':percent % off for the whole term' : ':percent % off the first billing period')|t({percent: sale.percent}) }} · {{ 'until :date'|t({date: sale.ends_at|dt}) }}</div>{% endif %}
<nav class="p-chips" aria-label="{{ 'Product groups'|t }}">
    <a class="p-chip{{ group == '' ? ' is-active' : '' }}" href="/store">{{ i.icon('grid') }} {{ 'All'|t }}</a>
    {% for key, g in groups %}<a class="p-chip{{ group == key ? ' is-active' : '' }}" href="/store?group={{ key }}">{{ i.icon(g.icon) }} {{ g.label|t }}</a>{% endfor %}
</nav>
{% if search %}<p class="muted">{{ 'Results for “:term”'|t({term: search}) }} · <a href="/store{{ group ? '?group=' ~ group : '' }}">{{ 'Reset search'|t }}</a></p>{% endif %}
{% for category, products in grouped %}
    <h2 class="mt-2">{{ categories[category]|default(category)|t }}</h2>
    <div class="grid grid-3">
        {% for p in products %}
        <div class="card product-card">
            <div class="card-header"><h3>{{ p.name }}</h3>{% if p.stock is not null and p.stock < 5 %}<span class="badge badge-warning">{{ 'only :n left'|t({n: p.stock}) }}</span>{% endif %}</div>
            <div class="card-body">
                <div class="price">{{ p.quote.recurring|money(p.currency) }}</div>
                <div class="small muted">{{ cycles[p.billing_cycle]|default(p.billing_cycle)|t }} {{ 'incl. tax'|t }}{% if p.setup_fee > 0 %} · {{ 'setup fee'|t }} {{ p.setup_fee|money(p.currency) }}{% endif %}</div>
                {% if p.description %}<p class="mt-1">{{ p.description }}</p>{% endif %}
                {% if p.feature_list|length > 0 %}<ul>{% for feature in p.feature_list %}<li>{{ feature }}</li>{% endfor %}</ul>{% endif %}
            </div>
            <div class="card-footer"><a class="btn btn-primary btn-block" href="/store/{{ p.slug }}">{{ 'Configure & order'|t }}</a></div>
        </div>
        {% endfor %}
    </div>
    {% if category == 'domain' and more_domains > 0 %}
    <form method="get" action="/store" class="card mt-1" role="search">
        <div class="card-body filters">
            <div class="form-row"><label for="f-domain-search">{{ ':count more endings – search for yours'|t({count: more_domains}) }}</label><input id="f-domain-search" type="search" name="search" placeholder=".shop" maxlength="100"></div>
            <button class="btn btn-outline" type="submit">{{ 'Search'|t }}</button>
        </div>
    </form>
    {% endif %}
{% else %}
    <div class="card"><div class="empty">{{ 'There are currently no products available.'|t }}</div></div>
{% endfor %}
{% endblock %}
