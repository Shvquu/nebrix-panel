{% extends 'layouts/website.twig' %}
{% import 'macros/icons.twig' as i %}
{% block title %}{{ current.title|t }}{% endblock %}
{% block description %}{{ current.teaser|t }}{% endblock %}
{% block content %}
<section class="site-banner">
    <div class="site-particles" aria-hidden="true">{% for n in 1..8 %}<span class="pt pt-{{ n }}"></span>{% endfor %}</div>
    <div class="site-container">
        <span class="site-icon-tile site-icon-lg">{{ i.icon(current.icon) }}</span>
        <h1>{{ current.title|t }}</h1>
        <p class="site-lead">{{ current.teaser|t }}</p>
    </div>
</section>

<section class="site-section">
    <div class="site-container">
        {% if products is not empty and configurable is not empty %}
        <div class="site-tabs" role="tablist" data-site-tabs>
            <button type="button" role="tab" class="is-active" aria-selected="true" data-site-tab="tab-packages">{{ i.icon('box') }} {{ 'Packages'|t }}</button>
            <button type="button" role="tab" aria-selected="false" data-site-tab="tab-configurator">{{ i.icon('sliders') }} {{ 'Configurator'|t }}</button>
        </div>
        {% endif %}

        {% if products is not empty %}
        <div id="tab-packages" class="site-plans">
            {% for p in products %}
            <article class="site-plan">
                <h2>{{ p.name }}</h2>
                {% if p.description %}<p class="site-muted">{{ p.description }}</p>{% endif %}
                <div class="site-price"><strong>{{ p.gross|money(p.currency) }}</strong> <span>{{ include('website/_cycle.twig', {cycle: p.billing_cycle}) }}</span></div>
                {% if p.setup_gross > 0 %}<div class="site-small site-muted">+ {{ p.setup_gross|money(p.currency) }} {{ 'setup fee'|t }}</div>{% endif %}
                {% if p.specs is not empty %}
                <dl class="site-specs">{% for spec in p.specs %}<div><dt>{{ spec.label|t }}</dt><dd>{{ spec.value|t }}</dd></div>{% endfor %}</dl>
                {% endif %}
                {% if p.features is not empty %}
                <ul class="site-checks">{% for feature in p.features %}<li>{{ i.icon('check') }}<span>{{ feature }}</span></li>{% endfor %}</ul>
                {% endif %}
                <a class="site-btn site-btn-primary site-btn-block" href="/store/{{ p.slug }}">{{ i.icon('cart') }} {{ 'Order now'|t }}</a>
            </article>
            {% endfor %}
        </div>
        {% endif %}

        {% if configurable is not empty %}
        <div id="tab-configurator" class="site-configurators{{ products is not empty ? ' hidden' : '' }}">
            {% set labels = {'cores': 'CPU cores', 'memory_gb': 'Memory', 'disk_gb': 'Disk'} %}
            {% set units = {'cores': ' vCores', 'memory_gb': ' GB', 'disk_gb': ' GB'} %}
            {% for p in configurable %}
            <form class="site-configurator" method="get" action="/store/{{ p.slug }}" data-configurator data-base="{{ p.net }}" data-rate="{{ p.tax_rate_bp }}" data-currency="{{ p.currency }}" data-locale="{{ locale }}">
                <div class="site-configurator-head">
                    <div>
                        <h2>{{ p.name }}</h2>
                        {% if p.description %}<p class="site-muted">{{ p.description }}</p>{% endif %}
                    </div>
                    <div class="site-price site-price-live"><strong data-price>{{ p.gross|money(p.currency) }}</strong> <span>{{ include('website/_cycle.twig', {cycle: p.billing_cycle}) }}</span></div>
                </div>
                <div class="site-sliders">
                    {% for name, range in p.configurator %}
                    <div class="site-slider{{ range.max == range.min ? ' is-fixed' : '' }}">
                        <label for="cfg-{{ p.id }}-{{ name }}">{{ i.icon(name == 'cores' ? 'cpu' : (name == 'memory_gb' ? 'layers' : 'database')) }} {{ labels[name]|t }} <output id="cfg-{{ p.id }}-{{ name }}-out">{{ range.min }}{{ units[name] }}</output></label>
                        {% if range.max > range.min %}
                        <input id="cfg-{{ p.id }}-{{ name }}" type="range" name="{{ name }}" min="{{ range.min }}" max="{{ range.max }}" step="{{ range.step }}" value="{{ range.min }}" data-step-price="{{ range.price }}" data-output="#cfg-{{ p.id }}-{{ name }}-out" data-unit="{{ units[name] }}">
                        <div class="site-slider-scale"><span>{{ range.min }}{{ units[name] }}</span><span>{{ range.max }}{{ units[name] }}</span></div>
                        {% else %}
                        <input type="hidden" name="{{ name }}" value="{{ range.min }}">
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% if p.features is not empty %}
                <ul class="site-checks site-checks-inline">{% for feature in p.features %}<li>{{ i.icon('check') }}<span>{{ feature }}</span></li>{% endfor %}</ul>
                {% endif %}
                <div class="site-configurator-foot">
                    <span class="site-small site-muted">{{ 'The binding price is shown before you order.'|t }}{% if p.setup_gross > 0 %} + {{ p.setup_gross|money(p.currency) }} {{ 'setup fee'|t }}{% endif %}</span>
                    <button class="site-btn site-btn-primary" type="submit">{{ i.icon('cart') }} {{ 'Configure & order'|t }}</button>
                </div>
            </form>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}
