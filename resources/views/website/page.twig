{% extends 'layouts/website.twig' %}
{% import 'macros/icons.twig' as i %}
{% block title %}{{ current.title|t }}{% endblock %}
{% block description %}{{ current.teaser|t }}{% endblock %}
{% block content %}
<section class="site-banner">
    <div class="site-particles" aria-hidden="true">{% for n in 1..8 %}<span class="pt pt-{{ n }}"></span>{% endfor %}</div>
    <div class="site-container">
        <span class="site-icon-tile site-icon-lg">{{ i.icon(current.icon) }}</span>
        <h1>{{ current.title|t }}</h1>
        <p class="site-lead">{{ current.teaser|t }}</p>
    </div>
</section>

<section class="site-section site-section-products">
    <div class="site-container">
        {% if promotion %}
        <div class="site-promo-banner">
            <span class="site-promo-icon">{{ i.icon('percent') }}</span>
            <div>
                <h2>{{ 'Promotion'|t }}</h2>
                <p>{{ (tabs|length > 1 ? 'Order now and get up to :percent % off for the whole term!' : 'Order now and get :percent % off for the whole term!')|t({percent: promotion.percent}) }}</p>
                <small>{{ (promotion.limited ? 'Offer valid until :date and while stocks last.' : 'Offer valid until :date.')|t({date: promotion.ends_at|dt}) }}</small>
            </div>
        </div>
        {% endif %}

        {% if tabs|length > 1 %}
        <div class="site-line-tabs" role="tablist" data-site-tabs>
            {% for tab in tabs %}
            <button type="button" role="tab" class="{{ loop.first ? 'is-active' : '' }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-site-tab="{{ tab.key }}">
                <strong>{{ tab.line ?? current.title|t }}</strong>
                <span>{{ (tab.kind == 'configurator' ? 'Configurator' : 'Packages')|t }}</span>
            </button>
            {% endfor %}
        </div>
        {% endif %}

        {% for tab in tabs %}
        <div id="{{ tab.key }}" class="site-tab-panel{{ loop.first ? '' : ' hidden' }}">
            {% if tab.sold_out %}
            <div class="site-soldout-notice">
                <span class="site-promo-icon">{{ i.icon('box') }}</span>
                <div><h2>{{ 'Available again soon'|t }}</h2><p>{{ 'These products are currently sold out. Please check back later.'|t }}</p></div>
            </div>
            {% endif %}

            {% if tab.kind == 'configurator' %}
                {% if key == 'teamspeak' %}
                <div class="site-heading site-heading-tight">
                    <h2>{{ 'TeamSpeak server configurator'|t }}</h2>
                    <p>{{ 'Choose the number of slots of your TeamSpeak server. If you need more or fewer later, you can change them at any time in the customer area.'|t }}</p>
                </div>
                {% endif %}
                {% for p in tab.products %}
                    {% include 'website/_configurator.twig' with {p: p} %}
                {% endfor %}
            {% else %}
            <div class="site-plans">
                {% for p in tab.products %}
                    {% include 'website/_plan.twig' with {p: p} %}
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</section>

{% if benefits is not empty %}
<section class="site-section site-section-alt site-benefits">
    <div class="site-container">
        <div class="site-heading">
            <h2>{{ 'Your advantages'|t }}</h2>
            <p>{{ 'Included with every :product.'|t({product: current.title|t}) }}</p>
        </div>
        <div class="site-benefit-grid">
            {% for b in benefits %}<div class="site-benefit"><h3>{{ b.title }}</h3>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div>{% endfor %}
        </div>
    </div>
</section>
{% endif %}
{% endblock %}
