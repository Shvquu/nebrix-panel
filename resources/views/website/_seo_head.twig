{# Canonical address, OpenGraph and Twitter card tags and schema.org data (Nebrix\Marketing\Seo).
   seo_title / seo_description are the rendered (already escaped) title and description blocks. #}
{% if seo.canonical|default(null) %}<link rel="canonical" href="{{ seo.canonical }}">
    {% endif %}<meta property="og:site_name" content="{{ brand.name }}">
    <meta property="og:type" content="{{ seo.type|default('website') }}">
    <meta property="og:title" content="{{ seo_title }}">
    <meta property="og:description" content="{{ seo_description }}">
    <meta property="og:locale" content="{{ locale == 'de' ? 'de_DE' : 'en_US' }}">
    {% if seo.canonical|default(null) %}<meta property="og:url" content="{{ seo.canonical }}">
    {% endif %}{% if seo.image|default(null) %}<meta property="og:image" content="{{ seo.image }}">
    {% endif %}{% if seo.published|default(null) %}<meta property="article:published_time" content="{{ seo.published }}">
    {% endif %}{% if seo.modified|default(null) %}<meta property="article:modified_time" content="{{ seo.modified }}">
    {% endif %}<meta name="twitter:card" content="{{ seo.image|default(null) ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ seo_title }}">
    <meta name="twitter:description" content="{{ seo_description }}">
    {% if seo.image|default(null) %}<meta name="twitter:image" content="{{ seo.image }}">
    {% endif %}{% if seo.json_ld|default(null) %}{{ seo.json_ld }}
{% endif %}
