{% extends 'layouts/admin.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Bank transfers'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Bank transfers'|t }}</h1><p class="muted">{{ 'Import bank statements: incoming transfers with exactly one open invoice number and exactly the open amount are booked as payment, everything else is listed for review. Outgoing payments are never booked.'|t }}</p></div>
    <a class="btn btn-outline" href="/admin/bank/profiles">{{ 'CSV profiles'|t }}</a>
</div>

<div class="card">
    <div class="card-header"><h2>{{ 'Import a statement'|t }}</h2></div>
    <div class="card-body">
        <form method="post" action="/admin/bank/import" enctype="multipart/form-data" class="filters">
            {{ csrf_field() }}
            {{ f.select('format', 'File format', formats, 'camt053') }}
            <div class="form-row"><label for="f-file">{{ 'Statement file'|t }}</label><input id="f-file" type="file" name="file" accept=".xml,.csv,.txt,text/xml,application/xml,text/csv">
                <div class="help">{{ 'CAMT.053 (XML) or CSV export of your bank, max. :kb KB. The file itself is not stored.'|t({kb: max_kb}) }}</div>
                {% if error('file') %}<div class="field-error">{{ error('file')|t }}</div>{% endif %}
            </div>
            <button class="btn btn-primary" type="submit">{{ 'Import'|t }}</button>
        </form>
    </div>
</div>

{% set labels = {review: 'To review', matched: 'Booked automatically', assigned: 'Assigned by staff', credited: 'Booked as credit', ignored: 'Ignored', debit: 'Outgoing'} %}
{% set reasons = {partial: 'Less than the invoice total', overpaid: 'More than the invoice total', multiple: 'Several invoice numbers', paid: 'Invoice no longer open', cancelled: 'Invoice cancelled', unknown: 'No invoice number found', currency: 'Different currency', reversal: 'Reversal by the bank', confirm: 'Clear match – please confirm'} %}
<div class="card mt-2">
    <div class="card-body"><form method="get" class="filters">
        <div class="form-row"><label for="f-status">{{ 'Status'|t }}</label>
            <select id="f-status" name="status" data-autosubmit>
                {% for key in statuses %}<option value="{{ key }}"{% if status == key %} selected{% endif %}>{{ labels[key]|t }} ({{ counts[key] }})</option>{% endfor %}
                <option value="all"{% if status == 'all' %} selected{% endif %}>{{ 'All'|t }}</option>
            </select>
        </div>
        <button class="btn btn-outline" type="submit">{{ 'Filter'|t }}</button>
    </form></div>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'Booked'|t }}</th><th class="text-right">{{ 'Amount'|t }}</th><th>{{ 'Payer / payee'|t }}</th><th>{{ 'Reference'|t }}</th><th>{{ 'Status'|t }}</th><th>{{ 'Invoice'|t }}</th><th></th></tr></thead>
        <tbody>
        {% for e in result.items %}
            <tr>
                <td class="nowrap">{{ e.booking_date|d }}</td>
                <td class="text-right nowrap">{{ e.direction == 'debit' ? '−' : '' }}{{ e.amount|money(e.currency) }}</td>
                <td>{{ e.counterparty_name ?: '–' }}{% if e.counterparty_iban %}<div class="small muted mono">{{ e.counterparty_iban }}</div>{% endif %}</td>
                <td class="small">{{ e.remittance|default('')|length > 90 ? e.remittance|slice(0, 90) ~ '…' : e.remittance }}</td>
                <td><span class="badge {{ e.status == 'review' ? 'badge-warning' : (e.status in ['matched', 'assigned', 'credited'] ? 'badge-success' : 'badge-neutral') }}">{{ labels[e.status]|t }}</span>{% if e.status == 'review' and e.reason %}<div class="small muted">{{ reasons[e.reason]|default(e.reason)|t }}</div>{% endif %}</td>
                <td>{% if e.invoice_number %}<a class="mono" href="/admin/invoices/{{ e.invoice_id }}">{{ e.invoice_number }}</a>{% else %}–{% endif %}</td>
                <td class="actions"><a class="btn btn-sm {{ e.status == 'review' ? 'btn-primary' : 'btn-outline' }}" href="/admin/bank/entries/{{ e.id }}">{{ e.status == 'review' ? 'Review'|t : 'View'|t }}</a></td>
            </tr>
        {% else %}<tr><td colspan="7" class="empty">{{ 'No entries.'|t }}</td></tr>{% endfor %}
        </tbody>
    </table></div>
    {% include 'partials/pagination.twig' with {total: result.total, per_page: 50} %}
</div>

<div class="card mt-2">
    <div class="card-header"><h2>{{ 'Recent imports'|t }}</h2></div>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'Date'|t }}</th><th>{{ 'File'|t }}</th><th>{{ 'Account'|t }}</th><th class="text-right">{{ 'New'|t }}</th><th class="text-right">{{ 'Already imported'|t }}</th><th class="text-right">{{ 'Booked'|t }}</th><th class="text-right">{{ 'To review'|t }}</th><th>{{ 'By'|t }}</th></tr></thead>
        <tbody>
        {% for i in imports %}
            <tr><td>{{ i.created_at|dt }}</td><td>{{ i.filename }}<div class="small muted">{{ i.format == 'camt053' ? 'CAMT.053' : 'CSV' }}{% if i.profile %} · {{ i.profile }}{% endif %}</div></td><td class="mono small">{{ i.account_iban ?: '–' }}</td><td class="text-right">{{ i.entries }}</td><td class="text-right">{{ i.duplicates }}</td><td class="text-right">{{ i.matched }}</td><td class="text-right">{{ i.review }}</td><td class="small">{{ i.email }}</td></tr>
        {% else %}<tr><td colspan="8" class="empty">{{ 'No statements imported yet.'|t }}</td></tr>{% endfor %}
        </tbody>
    </table></div>
</div>
{% endblock %}
