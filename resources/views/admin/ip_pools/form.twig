{% extends 'layouts/admin.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Add IP pool'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Add IP pool'|t }}</h1><p class="muted"><a href="/admin/ip-pools">&larr; {{ 'IP pools'|t }}</a></p></div></div>
<form method="post" action="/admin/ip-pools" novalidate class="card">
    {{ csrf_field() }}
    <div class="card-body">
        <div class="form-grid">
            {{ f.input('name', 'Name', '', 'text', {required: true}) }}
            {{ f.select('integration_id', 'Proxmox integration (optional)', integrations, '', {placeholder: '– any –'}) }}
            {{ f.input('network', 'Network (CIDR)', '', 'text', {required: true, placeholder: '203.0.113.0/24', help: 'IPv4 (/16 to /32; network, broadcast and gateway addresses are never assigned) or IPv6 (/48 to /128, e.g. 2001:db8:1::/64; single addresses, at most 4096 per pool, the gateway may be link-local such as fe80::1).'}) }}
            {{ f.input('gateway', 'Gateway', '', 'text', {required: true}) }}
            {{ f.input('first', 'First assignable address (optional)') }}
            {{ f.input('last', 'Last assignable address (optional)') }}
            {{ f.input('dns', 'DNS resolvers (comma-separated)', '', 'text', {placeholder: '1.1.1.1, 9.9.9.9'}) }}
            {{ f.input('note', 'Note') }}
            {% if robot_integrations|default({})|length > 0 %}{{ f.select('rdns_integration_id', 'Reverse DNS through Hetzner Robot', robot_integrations, '', {placeholder: '– none (no reverse DNS for customers) –'}) }}{% endif %}
        </div>
    </div>
    <div class="card-footer"><button class="btn btn-primary" type="submit">{{ 'Create pool'|t }}</button></div>
</form>
{% endblock %}
