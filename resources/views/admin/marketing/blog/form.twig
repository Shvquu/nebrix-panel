{% extends 'layouts/admin.twig' %}
{% import 'macros/forms.twig' as f %}
{% set p = post %}
{% block title %}{{ p ? p.title : 'New post'|t }}{% endblock %}
{% block content %}
<div class="page-header">
    <div><h1>{{ p ? p.title : 'New post'|t }}</h1>
        <p class="muted"><a href="/admin/blog">&larr; {{ 'Blog'|t }}</a>{% if p %} · <span class="badge {{ state == 'public' ? 'badge-success' : (state == 'scheduled' ? 'badge-info' : 'badge-neutral') }}">{{ (state == 'public' ? 'published' : state)|t }}</span> · <a href="/admin/blog/{{ p.id }}/preview" target="_blank" rel="noopener">{{ 'Preview'|t }}</a>{% endif %}</p>
    </div>
</div>
{% if not blog_enabled %}<div class="alert alert-info">{{ 'The blog is not shown on the website yet. Switch it on in Settings → Marketing.'|t }}</div>{% endif %}
<form method="post" action="{{ p ? '/admin/blog/' ~ p.id : '/admin/blog' }}" enctype="multipart/form-data" novalidate>
    {{ csrf_field() }}
    <div class="grid grid-2">
        <div class="card">
            <div class="card-header"><h2>{{ 'Post'|t }}</h2></div>
            <div class="card-body">
                {{ f.input('title', 'Title', p.title|default(''), 'text', {required: true, maxlength: 150}) }}
                {{ f.input('slug', 'Address', p.slug|default(''), 'text', {required: true, maxlength: 120, pattern: '[a-z0-9]+(-[a-z0-9]+)*', help: 'Lowercase letters, numbers and dashes – the post is reachable at /blog/<address>.'}) }}
                {{ f.textarea('teaser', 'Teaser', p.teaser|default(''), {rows: 3, maxlength: 500, help: 'Shown in the list of posts, in the feed and as description for search engines.'}) }}
                {{ f.input('author_name', 'Author', p ? p.author_name|default('') : default_author, 'text', {maxlength: 100}) }}
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h2>{{ 'Publication'|t }}</h2></div>
            <div class="card-body">
                {{ f.select('status', 'Status', {draft: 'Draft (only visible in the preview)', published: 'Published'}, p.status|default('draft')) }}
                {{ f.input('published_at', 'Publication date (empty = now)', published_at, 'datetime-local', {help: 'A date in the future schedules the post: it becomes public automatically at that time.'}) }}
                <div class="form-row">
                    <label for="f-cover">{{ 'Cover image (optional)'|t }}</label>
                    {% if p and p.cover_image %}<p><img class="logo-preview" src="/media/{{ p.cover_image }}" alt=""></p>{% endif %}
                    <input id="f-cover" type="file" name="cover" accept="image/png,image/jpeg">
                    <div class="help">{{ 'PNG or JPEG, max. 2 MB and 4096×4096 pixels. Also used as preview image when the post is shared.'|t }}</div>
                    {% if error('cover') %}<div class="field-error">{{ error('cover')|t }}</div>{% endif %}
                </div>
                {% if p and p.cover_image %}{{ f.checkbox('remove_cover', 'Remove the cover image', false) }}{% endif %}
            </div>
        </div>
    </div>
    <div class="card mt-2">
        <div class="card-header"><h2>{{ 'Text'|t }}</h2></div>
        <div class="card-body">
            {{ f.textarea('body', 'Text (Markdown)', p.body|default(''), {rows: 18, class: 'mono', help: 'Markdown: ## heading, **bold**, *italic*, - lists, > quotes, [link text](https://…). HTML is shown as text.'}) }}
        </div>
    </div>
    {% if can('content.manage') %}<div class="form-actions"><button class="btn btn-primary" type="submit">{{ 'Save'|t }}</button></div>{% endif %}
</form>
{% if p and can('content.manage') %}
<form method="post" action="/admin/blog/{{ p.id }}/delete" class="mt-2" data-confirm="{{ 'Delete this post?'|t }}">{{ csrf_field() }}<button class="btn btn-sm btn-outline text-danger" type="submit">{{ 'Delete post'|t }}</button></form>
{% endif %}
{% endblock %}
