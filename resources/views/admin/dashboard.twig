{% extends 'layouts/admin.twig' %}
{% block title %}{{ 'Admin dashboard'|t }}{% endblock %}
{% block content %}
{% import 'macros/icons.twig' as ic %}
<section class="p-card a-hero">
    <div>
        <p class="a-hero-kicker">{{ 'Administration'|t }}</p>
        <h1>{{ 'Hello :name'|t({name: auth_user.firstName ?: auth_user.displayName}) }}</h1>
        <p class="muted">{{ 'Overview of customers, sales, infrastructure and background processing.'|t }}</p>
    </div>
    <div class="a-hero-actions">
        {% if can('customers.manage') %}<a class="btn btn-primary" href="/admin/customers/create">{{ 'New customer'|t }}</a>{% endif %}
        {% if can('tickets.view') %}<a class="btn btn-outline" href="/admin/tickets">{{ 'Support tickets'|t }}{% if stats.tickets_open > 0 %} <span class="badge badge-warning">{{ stats.tickets_open }}</span>{% endif %}</a>{% endif %}
        {% if can('status.manage') %}<a class="btn btn-outline" href="/admin/status">{{ 'Status page'|t }}</a>{% endif %}
    </div>
</section>

{% for note in stats.notifications %}
    <div class="alert alert-{{ note.level == 'error' ? 'danger' : note.level }}">{{ note.message|t }}{% if note.link %} <a href="{{ note.link }}">{{ 'Open'|t }} &rarr;</a>{% endif %}</div>
{% endfor %}

<div class="a-stats">
    <a class="p-card p-stat" href="{{ can('customers.view') ? '/admin/customers' : '#' }}">
        <span class="p-stat-icon">{{ ic.icon('users') }}</span>
        <div class="p-stat-body"><div class="p-stat-label">{{ 'Customers'|t }}</div><div class="p-stat-value">{{ stats.customers_total }}</div><div class="p-stat-hint">{{ stats.customers_active }} {{ 'active'|t }} · {{ stats.customers_suspended }} {{ 'suspended'|t }} · {{ stats.customers_pending }} {{ 'pending'|t }}</div></div>
    </a>
    <a class="p-card p-stat" href="{{ can('orders.view') ? '/admin/orders' : '#' }}">
        <span class="p-stat-icon">{{ ic.icon('cart') }}</span>
        <div class="p-stat-body"><div class="p-stat-label">{{ 'Orders'|t }}</div><div class="p-stat-value">{{ stats.orders_total }}</div><div class="p-stat-hint">{{ stats.orders_pending }} {{ 'awaiting payment'|t }}</div></div>
    </a>
    <a class="p-card p-stat" href="{{ can('invoices.view') ? '/admin/invoices' : '#' }}">
        <span class="p-stat-icon">{{ ic.icon('trend') }}</span>
        <div class="p-stat-body"><div class="p-stat-label">{{ 'Revenue this month'|t }}</div><div class="p-stat-value">{{ stats.revenue_month|money(stats.currency) }}</div><div class="p-stat-hint">{{ 'Total'|t }}: {{ stats.revenue_total|money(stats.currency) }} · {{ stats.invoices_unpaid }} {{ 'unpaid invoices'|t }}</div></div>
    </a>
    <a class="p-card p-stat" href="{{ can('services.view') ? '/admin/services' : '#' }}">
        <span class="p-stat-icon">{{ ic.icon('services') }}</span>
        <div class="p-stat-body"><div class="p-stat-label">{{ 'Active services'|t }}</div><div class="p-stat-value">{{ stats.services_active }}</div><div class="p-stat-hint">{{ stats.products_active }} {{ 'active products'|t }} · {{ stats.tickets_open }} {{ 'open tickets'|t }}</div></div>
    </a>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="card-header"><h2>{{ 'Recent transactions'|t }}</h2>{% if can('transactions.view') %}<a href="/admin/transactions" class="small">{{ 'All'|t }}</a>{% endif %}</div>
        <div class="table-wrap"><table class="table">
            <thead><tr><th>{{ 'Date'|t }}</th><th>{{ 'Customer'|t }}</th><th>{{ 'Gateway'|t }}</th><th class="text-right">{{ 'Amount'|t }}</th><th>{{ 'Status'|t }}</th></tr></thead>
            <tbody>
            {% for t in stats.recent_transactions %}
                <tr><td>{{ t.created_at|dt }}</td><td>{{ t.email }}</td><td>{{ t.gateway|humanize|t }}</td><td class="text-right">{% if t.type == 'refund' %}−{% endif %}{{ t.amount|money(t.currency) }}</td><td><span class="badge {{ t.status|status_class }}">{{ t.status|t }}</span></td></tr>
            {% else %}<tr><td colspan="5" class="empty">{{ 'No transactions yet.'|t }}</td></tr>{% endfor %}
            </tbody>
        </table></div>
    </div>
    <div class="card">
        <div class="card-header"><h2>{{ 'Recent registrations'|t }}</h2>{% if can('customers.view') %}<a href="/admin/customers" class="small">{{ 'All'|t }}</a>{% endif %}</div>
        <div class="table-wrap"><table class="table">
            <thead><tr><th>{{ 'Customer'|t }}</th><th>{{ 'Registered'|t }}</th><th>{{ 'Status'|t }}</th></tr></thead>
            <tbody>
            {% for c in stats.recent_customers %}
                <tr><td>{% if can('customers.view') %}<a href="/admin/customers/{{ c.id }}">{{ c.email }}</a>{% else %}{{ c.email }}{% endif %}</td><td>{{ c.created_at|dt }}</td><td><span class="badge {{ c.status|status_class }}">{{ c.status|t }}</span></td></tr>
            {% else %}<tr><td colspan="3" class="empty">{{ 'No customers yet.'|t }}</td></tr>{% endfor %}
            </tbody>
        </table></div>
    </div>
</div>

<div class="grid grid-2">
    <div class="card">
        <div class="card-header"><h2>{{ 'Server & integration health'|t }}</h2>{% if can('integrations.view') %}<a href="/admin/integrations" class="small">{{ 'Manage'|t }}</a>{% endif %}</div>
        <div class="table-wrap"><table class="table">
            <thead><tr><th>{{ 'Integration'|t }}</th><th>{{ 'Type'|t }}</th><th>{{ 'Health'|t }}</th><th>{{ 'Last check'|t }}</th></tr></thead>
            <tbody>
            {% for i in stats.integrations %}
                <tr><td>{{ i.name }}{% if not i.is_enabled %} <span class="badge badge-neutral">{{ 'disabled'|t }}</span>{% endif %}</td><td>{{ i.type|humanize }}</td><td><span class="badge {{ i.health_status|status_class }}" title="{{ i.health_message }}">{{ i.health_status|t }}</span></td><td>{{ i.last_checked_at|dt }}</td></tr>
            {% else %}<tr><td colspan="4" class="empty">{{ 'No integrations configured yet.'|t }}</td></tr>{% endfor %}
            </tbody>
        </table></div>
    </div>
    <div class="card">
        <div class="card-header"><h2>{{ 'Background tasks'|t }}</h2>{% if can('jobs.view') %}<a href="/admin/jobs" class="small">{{ 'Jobs'|t }}</a>{% endif %}</div>
        <div class="card-body">
            <p>{{ 'Queue'|t }}:
                <span class="badge badge-warning">{{ stats.jobs.pending }} {{ 'pending'|t }}</span>
                <span class="badge badge-info">{{ stats.jobs.running }} {{ 'running'|t }}</span>
                <span class="badge badge-danger">{{ stats.jobs.failed }} {{ 'failed'|t }}</span>
                <span class="badge badge-success">{{ stats.jobs.completed }} {{ 'completed'|t }}</span>
            </p>
            <ul class="timeline">
            {% for task in stats.scheduler %}
                <li><strong>{{ task.task }}</strong> – {{ 'last run'|t }} {{ task.last_finished_at|dt }} <span class="badge {{ task.last_status|status_class }}">{{ task.last_status|default('–')|t }}</span></li>
            {% else %}
                <li class="muted">{{ 'The scheduler has not run yet.'|t }}</li>
            {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
